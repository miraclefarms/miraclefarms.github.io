# WeChat Official Account API credentials
WECHAT_APPID=
WECHAT_APPSECRET=
WECHAT_THUMB_MEDIA_ID=

# WeChat publisher runtime config
WECHAT_API_BASE_URL=https://api.weixin.qq.com/cgi-bin
WECHAT_DEFAULT_THUMB_IMAGE=assets/icons/favicon.png
WECHAT_TARGET_TIMEZONE=Asia/Shanghai

# OpenRouter image generation
OPENROUTER_API_KEY=
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
OPENROUTER_IMAGE_SIZE=1K
OPENROUTER_IMAGE_TIMEOUT_MS=180000
OPENROUTER_HTTP_REFERER=https://miraclefarms.github.io
OPENROUTER_X_TITLE=MiracleFarms WeChat Publisher
