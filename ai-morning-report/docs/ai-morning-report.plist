<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.miraclefarms.ai-morning-report</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/lychee/mycode/miraclefarms.github.io/ai-morning-report/bin/run-daily.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/local/Cellar/ruby/4.0.2/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/lychee</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>/Users/lychee/mycode/miraclefarms.github.io</string>
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>5</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/tmp/morning-report/logs/launchd-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/morning-report/logs/launchd-stderr.log</string>
</dict>
</plist>
